# ---- Required ----
MONGODB_URI=
JWT_SECRET=
PORT=5000
# comma separated: client URL, admin URL
CLIENT_URL=http://localhost:5173,http://localhost:5174
# ---- Admin (the admin chooses the password himself) ----
# Option 1: set it here (min 8 characters). Option 2: leave empty and run: npm run set-admin-password
ADMIN_EMAIL=skillspotAI@gmail.com
ADMIN_PASSWORD=
# ---- Login / Firebase ----
ALLOW_TEST_OTP=true
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT=
# ---- AI (optional) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# ---- Money rules (Rs) ----
# COMMISSION_RATE=0.10   SkillSpot keeps 10% of every paid job
# TAX_RATE=0.05          withheld from the freelancer earning (set your legal rate)
